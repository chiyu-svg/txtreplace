{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TxtReplace",
  "version": "0.1.0",
  "identifier": "com.rustadvance.txtreplace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文本替换 · TxtReplace",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#F2EDE4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "在 .txt / .docx / .xlsx 中批量查找替换文本",
    "longDescription": "递归扫描目录，在纯文本与 Office 文档中批量查找替换文本；写入前自动备份，可一键回滚。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
